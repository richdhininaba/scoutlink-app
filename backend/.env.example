# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://fwxnggklfsgrydcoeiuh.supabase.co
SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
# From Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=PASTE_YOUR_SUPABASE_JWT_SECRET_HERE

# ── OpenAI / AI-enhanced ScoutLink predictions ───────────
# Store the real API key only in Vercel -> scoutlink-api -> Environment Variables.
# Never expose this key to apps/scoutlink-web or commit a real value to GitHub.
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
# GPT-5.6 Sol is the premium analysis model used for the 8-credit prediction option.
# You can change this environment variable later without changing application code.
OPENAI_PREDICTION_MODEL=gpt-5.6-sol
# Server-side fail-safe. If OpenAI does not complete within this window, ScoutLink
# automatically returns the data-only prediction and charges only 1 credit.
OPENAI_PREDICTION_TIMEOUT_MS=15000

# ── SendGrid ─────────────────────────────────────────────
