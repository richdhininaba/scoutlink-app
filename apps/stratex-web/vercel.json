{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [],
  "functions": {
    "api/stratex-render.js": {
      "includeFiles": "{assets/stratex-public-v4-pages.json,pages/stratex-public-v4.html,pages/404.html}"
    },
    "api/stratex-sitemap.js": {
      "includeFiles": "assets/stratex-public-v4-pages.json"
    }
  },
  "rewrites": [
    {
      "source": "/frontend/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/frontend/js/:path*",
      "destination": "/js/:path*"
    },
    {
      "source": "/frontend/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/frontend/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/frontend/data/:path*",
      "destination": "/data/:path*"
    },
    {
      "source": "/frontend/pages/:path*",
      "destination": "/pages/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/stratex-sitemap"
    },
    {
      "source": "/",
      "destination": "/api/stratex-render?path=/"
    },
    {
      "source": "/scoutlink",
      "destination": "/api/stratex-render?path=/scoutlink"
    },
    {
      "source": "/about",
      "destination": "/api/stratex-render?path=/about"
    },
    {
      "source": "/leadership",
      "destination": "/api/stratex-render?path=/leadership"
    },
    {
      "source": "/trust",
      "destination": "/api/stratex-render?path=/trust"
    },
    {
      "source": "/careers",
      "destination": "/api/stratex-render?path=/careers"
    },
    {
      "source": "/careers/:slug",
      "destination": "/api/stratex-render?path=/careers/:slug"
    },
    {
      "source": "/learning-centre",
      "destination": "/api/stratex-render?path=/learning-centre"
    },
    {
      "source": "/learning-centre/:slug",
      "destination": "/api/stratex-render?path=/learning-centre/:slug"
    },
    {
      "source": "/contact",
      "destination": "/api/stratex-render?path=/contact"
    },
    {
      "source": "/report-a-concern",
      "destination": "/api/stratex-render?path=/report-a-concern"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/stratex-render?path=/privacy-policy"
    },
    {
      "source": "/terms",
      "destination": "/api/stratex-render?path=/terms"
    },
    {
      "source": "/cookie-policy",
      "destination": "/api/stratex-render?path=/cookie-policy"
    },
    {
      "source": "/security",
      "destination": "/api/stratex-render?path=/security"
    },
    {
      "source": "/accessibility",
      "destination": "/api/stratex-render?path=/accessibility"
    },
    {
      "source": "/showcase-event",
      "destination": "/api/stratex-render?path=/showcase-event"
    },
    {
      "source": "/award-ceremonies",
      "destination": "/pages/stratex-public-v4"
    },
    {
      "source": "/showcase-event/player-registration",
      "destination": "/pages/showcase-player-registration"
    },
    {
      "source": "/showcase-event/player-registration/complete",
      "destination": "/pages/showcase-player-registration"
    },
    {
      "source": "/showcase-event/coach-scout-registration",
      "destination": "/pages/showcase-professional-registration"
    },
    {
      "source": "/showcase-event/coach-scout-registration/complete",
      "destination": "/pages/showcase-professional-registration"
    },
    {
      "source": "/showcase-event/coach-scout-registration/sold-out",
      "destination": "/pages/showcase-professional-registration"
    },
    {
      "source": "/admin",
      "destination": "/pages/stratex-company-admin"
    },
    {
      "source": "/admin/usage-requests",
      "destination": "/pages/stratex-usage-requests"
    },
    {
      "source": "/admin/showcase-event",
      "destination": "/pages/stratex-showcase-events"
    },
    {
      "source": "/admin/:module",
      "destination": "/pages/stratex-company-admin"
    },
    {
      "source": "/company/admin",
      "destination": "/pages/stratex-company-admin"
    },
    {
      "source": "/stratex/dashboard",
      "destination": "/pages/stratex-dashboard"
    },
    {
      "source": "/stratex/company-site",
      "destination": "/pages/stratex-company-admin"
    },
    {
      "source": "/stratex/registrations",
      "destination": "/pages/stratex-registrations"
    },
    {
      "source": "/stratex/users",
      "destination": "/pages/stratex-users"
    },
    {
      "source": "/stratex/org",
      "destination": "/pages/stratex-org"
    },
    {
      "source": "/stratex/hiring",
      "destination": "/pages/stratex-hiring"
    },
    {
      "source": "/stratex/leave",
      "destination": "/pages/stratex-leave"
    },
    {
      "source": "/stratex/meetings",
      "destination": "/pages/stratex-meetings"
    },
    {
      "source": "/stratex/contracts-pay",
      "destination": "/pages/stratex-contracts-pay"
    },
    {
      "source": "/stratex/players",
      "destination": "/pages/stratex-players"
    },
    {
      "source": "/stratex/scouts",
      "destination": "/pages/stratex-scouts"
    },
    {
      "source": "/stratex/usage-requests",
      "destination": "/pages/stratex-usage-requests"
    },
    {
      "source": "/stratex/coaches",
      "destination": "/pages/stratex-coaches"
    },
    {
      "source": "/stratex/messages",
      "destination": "/pages/stratex-messages"
    },
    {
      "source": "/stratex/scout-teams",
      "destination": "/pages/stratex-scout-teams"
    },
    {
      "source": "/stratex/school-teams",
      "destination": "/pages/stratex-school-teams"
    },
    {
      "source": "/stratex/non-pro-academies",
      "destination": "/pages/stratex-school-teams"
    },
    {
      "source": "/stratex/award-nominations",
      "destination": "/pages/stratex-award-nominations"
    },
    {
      "source": "/stratex/showcase-events",
      "destination": "/pages/stratex-showcase-events"
    },
    {
      "source": "/stratex/notifications",
      "destination": "/pages/stratex-notifications"
    },
    {
      "source": "/stratex/concerns",
      "destination": "/pages/stratex-concerns"
    },
    {
      "source": "/stratex/settings",
      "destination": "/pages/stratex-settings"
    },
    {
      "source": "/404",
      "destination": "/pages/404"
    }
  ]
}
