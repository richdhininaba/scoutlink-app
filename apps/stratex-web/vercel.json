      "permanent": false
    },
    {
      "source": "/stratex/coaches",
      "destination": "/admin/scoutlink/coaches",
      "permanent": false
    },
    {
      "source": "/stratex/messages",
      "destination": "/admin/crm",
      "permanent": false
